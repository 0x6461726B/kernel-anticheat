;
; kernel.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = ActivityMonitor
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
CatalogFile = kernel.cat
DriverVer   = 06/13/2026,1.0.0.0 ; Set your date/version
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
kernel.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%kernel.DeviceDesc% = kernel_Device, Root\kernel ; TODO: edit hw-id

[kernel_Device.NT]
CopyFiles = File_Copy

[File_Copy]
kernel.sys

;-------------- Service installation
[kernel_Device.NT.Services]
AddService = kernel,%SPSVCINST_ASSOCSERVICE%, kernel_Service_Inst

; -------------- kernel driver install sections
[kernel_Service_Inst]
DisplayName    = %kernel.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\kernel.sys
LoadOrderGroup = "FSFilter Anti-Virus"
Dependencies   = FltMgr
AddReg         = kernel.AddRegistry


[kernel.AddRegistry]
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\" %Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\" %Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%


[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "ScoutAC" ;TODO: Replace with your manufacturer name
DiskName = "kernel Installation Disk"
kernel.DeviceDesc = "kernel Device"
kernel.SVCDESC = "kernel Service"
DefaultInstance    = "kernelInstance"
Instance1.Name     = "kernelInstance"
Instance1.Altitude = "320000" ; 320000-329999 is standard for Anti-Virus/Anti-Cheat FS Filters
Instance1.Flags    = 0x0         ; 0 means automatic attachment to all volumes
